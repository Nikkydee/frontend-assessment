{
  "name": "frontend_assessment",
  "version": "1.0.0",
  "description": "Playwright UI automation for the Login -> OTP -> Funds Transfer flow",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:sanity": "npx playwright test --grep \"@sanity\"",
    "test:report": "allure generate --single-file ./allure-results -o ./reports --clean --report-name \"Funds_Transfer_Automation\"",
    "test:test-report": "npm test && npm run test:report"
  },
  "keywords": [],
  "author": "Adenike Olapetan",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure-playwright": "^3.12.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.1"
  }
}
